{
  "manifest_version": 3,
  "name": "Meet Soundboard",
  "version": "1.0.0",
  "description": "Envoie des sons dans ton micro pendant un appel Google Meet.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.myinstants.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Meet Soundboard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*.mp3"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "shared/settings.js",
        "content/studio.js",
        "content/bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
